# Copier ce fichier en .env (jamais commité) pour afficher tes écoutes Jellyfin en local.
# En ligne, ces trois valeurs sont des secrets du dépôt GitHub (voir README).
JELLYFIN_URL=https://jellyfin.exemple.fr
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# Clé API TMDB (themoviedb.org › Paramètres › API), pour télécharger les affiches.
TMDB_API_KEY=
