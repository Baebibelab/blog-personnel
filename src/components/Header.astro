---
import { href, otherLang, t, type Lang, type UiKey } from '../i18n/ui';
import { site } from '../site.config';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;

const nav: { key: UiKey; path: string }[] = [
  { key: 'nav.journal', path: 'journal' },
  { key: 'nav.notes', path: 'notes' },
  { key: 'nav.projects', path: 'projects' },
  { key: 'nav.shelf', path: 'shelf' },
  { key: 'nav.listening', path: 'listening' },
  { key: 'nav.about', path: 'about' },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href(lang)}>{site.author}</a>
    <a class="lang" href={altHref} hreflang={otherLang(lang)} lang={otherLang(lang)}>
      {t(lang, 'nav.switch')}
    </a>
  </div>
  <nav class="container" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
    <ul>
      {
        nav.map(({ key, path }) => {
          const target = href(lang, path);
          const active = current.startsWith(target);
          return (
            <li>
              <a href={target} aria-current={active ? 'page' : undefined}>
                {t(lang, key)}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 1.25rem 0 0.5rem;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }

  .lang {
    font-size: 0.9rem;
    color: var(--muted);
  }

  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0.6rem 0 0;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
</style>
