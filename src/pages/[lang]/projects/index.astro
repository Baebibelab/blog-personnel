---
import Base from '../../../layouts/Base.astro';
import { href, langs, t, type Lang } from '../../../i18n/ui';
import { entrySlug, getProjects } from '../../../lib/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const projects = await getProjects(lang);
---

<Base lang={lang} title={t(lang, 'projects.title')} description={t(lang, 'projects.intro')}>
  <h1>{t(lang, 'projects.title')}</h1>
  <p class="lead">{t(lang, 'projects.intro')}</p>
  <div class="grid">
    {
      projects.map((p) => (
        <a class="card" href={href(lang, 'projects', entrySlug(p.id))}>
          <h3>{p.data.title}</h3>
          <p class="muted">{p.data.tagline}</p>
          <p class="small" style="margin-top: 0.6rem">
            <span class="tag">{t(lang, `status.${p.data.status}`)}</span>
            {p.data.platform && <span class="muted"> · {p.data.platform}</span>}
          </p>
        </a>
      ))
    }
  </div>
</Base>
