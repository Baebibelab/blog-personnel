---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { formatDate, langs, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const items = (await getCollection('shelf')).sort(
  (a, b) => b.data.finished.valueOf() - a.data.finished.valueOf(),
);

// Regroupe les œuvres par année de fin.
const byYear = new Map<number, typeof items>();
for (const item of items) {
  const year = item.data.finished.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), item]);
}

const icons = { book: '📖', manga: '📚', film: '🎬', series: '📺', album: '💿' } as const;
const filters = ['all', 'book', 'manga', 'film', 'series', 'album'] as const;
// Note arrondie à la demi-étoile : 3.5 donne trois étoiles pleines, une demie et une vide.
// Renvoie le remplissage de chacune des cinq étoiles, pour pouvoir les animer une par une.
const stars = (n: number) => {
  const halves = Math.round(n * 2);
  return [0, 1, 2, 3, 4].map((i) =>
    halves >= 2 * (i + 1) ? 'full' : halves === 2 * i + 1 ? 'half' : 'empty',
  );
};
// Répliques de la bulle de l'effet fourth-wall : une nouvelle à chaque survol.
const quips = [
  'Hé, mes yeux sont plus haut.',
  'Tu survoles souvent les gens comme ça ?',
  '4/5 ? Je vais faire semblant de ne pas avoir vu.',
  'Oui, je sais que je suis sur un site perso.',
];
// Grains de poussière de l'effet snap : position de départ dans la couverture (en %),
// puis distance parcourue en s'envolant (en px).
const dust = [
  [88, 12, 26, -30],
  [80, 34, 34, -18],
  [92, 52, 22, -36],
  [74, 70, 38, -24],
  [86, 88, 30, -12],
  [62, 20, 30, -40],
  [56, 46, 42, -26],
  [66, 82, 34, -34],
  [44, 28, 40, -20],
  [38, 60, 46, -38],
  [48, 90, 36, -16],
  [24, 14, 44, -32],
  [18, 44, 50, -22],
  [28, 76, 40, -42],
  [10, 92, 48, -28],
  [8, 30, 54, -36],
];
// Moment où le front de poussière atteint un grain placé à x % du bord gauche : le front part
// du bord droit à 0,24 s et traverse la couverture (de -35 % à 110 %) en 1,26 s (voir @keyframes snap).
const dustDelay = (x: number) => (0.24 + ((100 - x + 35) / 145) * 1.26).toFixed(2);
// Spores du Monde à l'envers (effet upside-down) : position de départ (en %) et durée de montée.
const spores = [
  [12, 80, 3.2],
  [30, 60, 4.1],
  [48, 90, 3.6],
  [66, 70, 4.4],
  [82, 85, 3.4],
  [22, 40, 4.8],
  [58, 30, 3.9],
  [90, 50, 4.6],
];
// Fissures de l'effet crack, dans un repère de 100 × 150 (proportions d'une affiche), autour
// du point d'impact. Chaque rayon part dans une direction et zigzague un peu à chaque segment.
const impact = [62, 52];
const cracks = [12, 58, 97, 143, 188, 226, 262, 305, 338].map((deg, i) => {
  const length = [62, 48, 70, 55, 66, 44, 72, 50, 58][i];
  let [x, y] = impact;
  let d = `M${x} ${y}`;
  for (let step = 1; step <= 4; step++) {
    const a = ((deg + (step % 2 ? 9 : -9) * (i % 2 ? 1 : -1)) * Math.PI) / 180;
    x += (Math.cos(a) * length) / 4;
    y += (Math.sin(a) * length) / 4;
    d += ` L${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return d;
});
// Sommets du cercle magique de l'effet glyph : six petits cercles posés sur l'anneau.
const runes = [0, 1, 2, 3, 4, 5].map((i) => {
  const angle = ((i * 60 - 90) * Math.PI) / 180;
  return [50 + 40 * Math.cos(angle), 50 + 40 * Math.sin(angle)].map((n) => n.toFixed(1));
});
// Toile d'araignée de l'effet web, dans le même repère de 100 × 150, accrochée au coin haut
// droit : des rayons qui partent du coin, puis des fils qui les relient en pendant un peu.
const webAngles = [92, 108, 124, 140, 156, 172];
const webPoint = (deg: number, r: number) =>
  [100 + r * Math.cos((deg * Math.PI) / 180), r * Math.sin((deg * Math.PI) / 180)]
    .map((n) => n.toFixed(1))
    .join(' ');
const web = [
  ...webAngles.map((deg) => `M100 0 L${webPoint(deg, 170)}`),
  ...[18, 36, 56, 80, 108].map((r) =>
    webAngles
      .map((deg, i) =>
        i === 0
          ? `M${webPoint(deg, r)}`
          : // Le point de contrôle, rapproché du coin, fait pendre le fil entre deux rayons.
            `Q${webPoint((deg + webAngles[i - 1]) / 2, r * 0.84)} ${webPoint(deg, r)}`,
      )
      .join(' '),
  ),
];
// Bandes de l'effet split-screen : découpe de chaque tiers (avec un filet entre elles), sens
// d'arrivée et teinte.
const strips = [
  ['inset(0 calc(66.67% + 1.5px) 0 0)', -1, 'sepia(0.6) saturate(1.8) hue-rotate(-10deg)'],
  ['inset(0 calc(33.33% + 1.5px) 0 calc(33.33% + 1.5px))', 1, 'hue-rotate(160deg) saturate(1.3)'],
  ['inset(0 0 0 calc(66.67% + 1.5px))', -1, 'grayscale(1) contrast(1.25)'],
] as const;
---

<Base lang={lang} title={t(lang, 'shelf.title')} description={t(lang, 'shelf.intro')}>
  <h1>{t(lang, 'shelf.title')}</h1>
  <p class="lead">{t(lang, 'shelf.intro')}</p>

  {
    items.length === 0 ? (
      <p class="muted">{t(lang, 'shelf.empty')}</p>
    ) : (
      <>
        <div class="filters" role="group">
          {filters.map((f) => (
            <button type="button" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>
              {t(lang, f === 'all' ? 'shelf.all' : `shelf.${f}`)}
            </button>
          ))}
        </div>

        {[...byYear].map(([year, works]) => (
          <section data-year>
            <h2>{year}</h2>
            <ul class="works">
              {works.map(({ data }) => (
                <li data-type={data.type}>
                  <span class="icon" aria-hidden="true">
                    {icons[data.type]}
                  </span>
                  <div class="body">
                    <strong>{data.title}</strong>
                    <span class="muted">
                      {' '}
                      — {data.creator}
                      {data.year && ` (${data.year})`}
                    </span>
                    {data.progress && <span class="progress small">{data.progress}</span>}
                    {data.rating !== undefined && (
                      <span
                        class="stars"
                        role="img"
                        aria-label={`${data.rating.toLocaleString(lang)}/5`}
                        data-stars
                      >
                        {stars(data.rating).map((fill, i) => (
                          <span class:list={['star', fill]} style={`--i: ${i}`}>
                            ☆
                          </span>
                        ))}
                      </span>
                    )}
                    {data.review && <p>{data.review}</p>}
                    {/* Une année seule est déjà donnée par le titre de la section. */}
                    {data.finishedPrecision !== 'year' && (
                      <time
                        class="muted small"
                        datetime={data.finished
                          .toISOString()
                          .slice(0, data.finishedPrecision === 'month' ? 7 : 10)}
                      >
                        {formatDate(data.finished, lang, data.finishedPrecision)}
                      </time>
                    )}
                  </div>
                  {data.cover && (
                    <span
                      class="cover-tilt"
                      data-tilt={data.effect ? undefined : ''}
                      data-effect={data.effect}
                    >
                      <Image class="cover" src={data.cover} alt="" width={160} loading="lazy" />
                      <span class="glare" aria-hidden="true" />
                      {/* Impacts de balle : position dans la couverture et ordre de tir. */}
                      {data.effect === 'bullets' &&
                        [
                          [30, 26],
                          [70, 50],
                          [38, 76],
                        ].map(([x, y], i) => (
                          <span
                            class="hole"
                            style={`--x: ${x}%; --y: ${y}%; --i: ${i}`}
                            aria-hidden="true"
                          />
                        ))}
                      {/* Couverture tranchée : une copie de la moitié haute, posée sur l'image,
                          qui s'en détache au survol, et le trait de lame. */}
                      {data.effect === 'slash' && (
                        <>
                          <Image
                            class="cover slice-top"
                            src={data.cover}
                            alt=""
                            width={160}
                            loading="lazy"
                            aria-hidden="true"
                          />
                          <span class="slash" aria-hidden="true" />
                        </>
                      )}
                      {/* Éclipse : un voile sombre bordé de rouge, et le disque qui se lève. */}
                      {data.effect === 'eclipse' && (
                        <>
                          <span class="eclipse-veil" aria-hidden="true" />
                          <span class="eclipse" aria-hidden="true" />
                        </>
                      )}
                      {/* Quatrième mur : la bulle, dont le script change la réplique à chaque survol. */}
                      {data.effect === 'fourth-wall' && (
                        <span class="bubble" aria-hidden="true" data-quips={JSON.stringify(quips)}>
                          {quips[0]}
                        </span>
                      )}
                      {/* Pomme : dessinée ici plutôt qu'en emoji, pour être la même partout. */}
                      {data.effect === 'apple' && (
                        <span class="apple" aria-hidden="true">
                          <svg viewBox="0 0 40 44">
                            <path d="M21 11c1-5 5-8 10-8-1 5-5 8-10 8z" fill="#3f8f3a" />
                            <path
                              d="M20 13c-.5-3-1.5-6-3.5-8"
                              stroke="#5b3a1e"
                              stroke-width="2.2"
                              stroke-linecap="round"
                              fill="none"
                            />
                            <path
                              d="M20 13c-8-6-18-2-18 10 0 12 8 21 14 20 2-.5 3-1 4-1s2 .5 4 1c6 1 14-8 14-20 0-12-10-16-18-10z"
                              fill="#d62828"
                            />
                            <ellipse
                              cx="11"
                              cy="22"
                              rx="2.5"
                              ry="6"
                              fill="#fff"
                              opacity="0.35"
                              transform="rotate(20 11 22)"
                            />
                          </svg>
                        </span>
                      )}
                      {/* Portail : le disque vert, derrière la couverture qu'il aspire. */}
                      {data.effect === 'portal' && <span class="portal" aria-hidden="true" />}
                      {/* Claquement de doigts : les grains de poussière qui s'envolent. */}
                      {data.effect === 'snap' &&
                        dust.map(([x, y, dx, dy]) => (
                          <span
                            class="dust"
                            style={`--x: ${x}%; --y: ${y}%; --dx: ${dx}px; --dy: ${dy}px; --delay: ${dustDelay(x)}s`}
                            aria-hidden="true"
                          />
                        ))}
                      {/* Cercle magique : chaque trait a une longueur ramenée à 1 (pathLength),
                          pour pouvoir le dessiner avec le même décalage de tirets. */}
                      {data.effect === 'glyph' && (
                        <svg class="glyph" viewBox="0 0 100 100" aria-hidden="true">
                          <circle cx="50" cy="50" r="45" pathLength="1" style="--i: 0" />
                          <circle cx="50" cy="50" r="35" pathLength="1" style="--i: 1" />
                          <path d="M50 15 80.3 67.5H19.7Z" pathLength="1" style="--i: 2" />
                          <path d="M50 85 19.7 32.5H80.3Z" pathLength="1" style="--i: 3" />
                          {runes.map(([cx, cy], i) => (
                            <circle
                              cx={cx}
                              cy={cy}
                              r="3.5"
                              pathLength="1"
                              style={`--i: ${4 + i * 0.25}`}
                            />
                          ))}
                        </svg>
                      )}
                      {/* Monde à l'envers : le voile froid traversé d'éclairs rouges, et les spores. */}
                      {data.effect === 'upside-down' && (
                        <>
                          <span class="upside-veil" aria-hidden="true" />
                          {spores.map(([x, y, s]) => (
                            <span
                              class="spore"
                              style={`--x: ${x}%; --y: ${y}%; --s: ${s}s`}
                              aria-hidden="true"
                            />
                          ))}
                        </>
                      )}
                      {/* Écran brisé : le point d'impact et les fissures qui en partent. */}
                      {data.effect === 'crack' && (
                        <svg
                          class="cracks"
                          viewBox="0 0 100 150"
                          preserveAspectRatio="none"
                          aria-hidden="true"
                        >
                          <circle cx={impact[0]} cy={impact[1]} r="4" pathLength="1" />
                          <circle cx={impact[0]} cy={impact[1]} r="11" pathLength="1" />
                          {cracks.map((d) => (
                            <path d={d} pathLength="1" />
                          ))}
                        </svg>
                      )}
                      {/* Comète : le ciel de crépuscule, puis la comète et le fragment qui s'en détache. */}
                      {data.effect === 'comet' && (
                        <>
                          <span class="twilight" aria-hidden="true" />
                          <span class="comet" aria-hidden="true" />
                          <span class="comet comet-shard" aria-hidden="true" />
                        </>
                      )}
                      {/* Projecteur : il tombe du ciel, éclaire la couverture et le voyant « EN
                          DIRECT » s'allume. */}
                      {data.effect === 'spotlight' && (
                        <>
                          <span class="beam" aria-hidden="true" />
                          <span class="on-air" aria-hidden="true">
                            ● EN DIRECT
                          </span>
                          <span class="stage-light" aria-hidden="true">
                            <svg viewBox="0 0 40 40">
                              <path d="M8 6h4v6H8zM28 6h4v6h-4z" fill="#555" />
                              <path d="M6 4h28" stroke="#555" stroke-width="3" stroke-linecap="round" />
                              <path d="M7 12h26l-4 18H11z" fill="#2b2b2b" />
                              <ellipse cx="20" cy="30" rx="9" ry="3.5" fill="#fff6c8" />
                              <path d="M12 16h16" stroke="#444" stroke-width="2" />
                            </svg>
                          </span>
                        </>
                      )}
                      {/* Extension du territoire : les ténèbres qui se referment, puis l'éclair noir. */}
                      {data.effect === 'domain' && (
                        <>
                          <span class="domain" aria-hidden="true" />
                          <svg
                            class="black-flash"
                            viewBox="0 0 100 150"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                          >
                            <path d="M72 6 56 46l13 4-27 44 12 3-22 46" />
                            <path d="M18 28l16 30-10 4 20 38" />
                          </svg>
                        </>
                      )}
                      {/* Toile d'araignée : rayons puis fils, tracés l'un après l'autre. */}
                      {data.effect === 'web' && (
                        <svg class="web" viewBox="0 0 100 150" preserveAspectRatio="none" aria-hidden="true">
                          {web.map((d, i) => (
                            <path d={d} pathLength="1" style={`--i: ${i < 6 ? i : 7 + (i - 6) * 2}`} />
                          ))}
                        </svg>
                      )}
                      {/* Écran partagé : trois copies de la couverture, chacune réduite à une bande. */}
                      {data.effect === 'split-screen' &&
                        strips.map(([clip, dir, tint], i) => (
                          <Image
                            class="cover strip"
                            src={data.cover}
                            alt=""
                            width={160}
                            loading="lazy"
                            aria-hidden="true"
                            style={`--clip: ${clip}; --dir: ${dir}; --tint: ${tint}; --i: ${i}`}
                          />
                        ))}
                      {/* Triangle à l'œil unique, sur un voile jaune. */}
                      {data.effect === 'cipher' && (
                        <>
                          <span class="cipher-tint" aria-hidden="true" />
                          <span class="cipher" aria-hidden="true">
                            <svg viewBox="0 0 60 56">
                              <path d="M30 4 56 50H4Z" fill="#f7d33a" stroke="#2a2a2a" stroke-width="2" stroke-linejoin="round" />
                              <path d="M17 39h26M12 45h36" stroke="#c9a21f" stroke-width="1.5" />
                              <g class="cipher-eye">
                                <ellipse cx="30" cy="28" rx="9" ry="6" fill="#fff" stroke="#2a2a2a" stroke-width="1.5" />
                                <ellipse cx="30" cy="28" rx="1.8" ry="4.5" fill="#111" />
                              </g>
                            </svg>
                          </span>
                        </>
                      )}
                      {/* Onde de choc dorée, en deux anneaux. */}
                      {data.effect === 'skadoosh' &&
                        [0, 1].map((i) => <span class="shockwave" style={`--i: ${i}`} aria-hidden="true" />)}
                      {/* Souffle de l'eau : une vague bleue, son reflet clair et sa crête d'écume. */}
                      {data.effect === 'water' && (
                        <svg class="water" viewBox="0 0 100 150" preserveAspectRatio="none" aria-hidden="true">
                          <path
                            class="wave"
                            d="M-10 130C15 95 35 135 55 100S95 55 75 40 40 40 45 62s27 13 29-7"
                            pathLength="1"
                            style="--i: 0"
                          />
                          <path
                            class="crest"
                            d="M-13 126C12 91 32 131 52 96S92 51 72 36 37 36 42 58s27 13 29-7"
                            pathLength="1"
                            style="--i: 1"
                          />
                          <path
                            class="foam"
                            d="M-10 130C15 95 35 135 55 100S95 55 75 40 40 40 45 62s27 13 29-7"
                            pathLength="1"
                            style="--i: 2"
                          />
                        </svg>
                      )}
                      {/* Parachutiste : la voile (qui s'affaisse à l'atterrissage), les suspentes
                          et le bonhomme. */}
                      {data.effect === 'parachute' && (
                        <span class="parachute" aria-hidden="true">
                          <svg viewBox="0 0 40 50">
                            <g class="canopy">
                              <path
                                d="M3 18Q20-4 37 18q-4-3-8 0-4.5-3-9 0-4.5-3-9 0-4-3-8 0z"
                                fill="#f4efe2"
                                stroke="#6b6b6b"
                                stroke-width="1.2"
                              />
                              <path d="M20 5.5Q15 10 15.5 18M20 5.5Q25 10 24.5 18" stroke="#c0392b" stroke-width="2.4" fill="none" />
                            </g>
                            <path d="M3 18 18 38M11 18l7.5 20M29 18l-7.5 20M37 18 22 38" stroke="#6b6b6b" stroke-width="0.6" />
                            <circle cx="20" cy="38.5" r="2.4" fill="#3a3a3a" />
                            <path d="M17.5 41h5l-.5 6h-4z" fill="#556b2f" />
                            <path d="M18.5 47v3M21.5 47v3" stroke="#3a3a3a" stroke-width="1.2" />
                          </svg>
                        </span>
                      )}
                      {/* Signal de chauve-souris : la nuit, la pluie, le faisceau et le disque. */}
                      {data.effect === 'bat-signal' && (
                        <>
                          <span class="night" aria-hidden="true" />
                          <span class="rain" aria-hidden="true" />
                          <span class="signal-beam" aria-hidden="true" />
                          <span class="signal" aria-hidden="true">
                            <svg viewBox="0 0 100 50">
                              <path
                                d="M50 14 46 5l-2 9C36 8 22 6 4 12c10 4 14 12 12 22 8-6 16-4 20 4 4-6 10-6 14 4 4-10 10-10 14-4 4-8 12-10 20-4-2-10 2-18 12-22-18-6-32-4-40 2l-2-9z"
                                fill="#141414"
                              />
                            </svg>
                          </span>
                        </>
                      )}
                      {/* Soucoupe volante et son rayon tracteur. */}
                      {data.effect === 'ufo' && (
                        <>
                          <span class="tractor" aria-hidden="true" />
                          <span class="saucer" aria-hidden="true">
                            <svg viewBox="0 0 60 26">
                              <path d="M19 13Q30-3 41 13z" fill="rgb(160 230 255 / 0.85)" stroke="#4a5866" stroke-width="1" />
                              <ellipse cx="30" cy="16" rx="28" ry="7" fill="#9aa4b1" stroke="#4a5866" stroke-width="1.2" />
                              <ellipse cx="30" cy="14" rx="20" ry="2.5" fill="#c3cad3" />
                              {[12, 21, 30, 39, 48].map((cx, i) => (
                                <circle class="ufo-light" cx={cx} cy={i % 4 === 0 ? 17 : 19} r="1.8" style={`--i: ${i}`} />
                              ))}
                            </svg>
                          </span>
                        </>
                      )}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</Base>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Filtres. Quand le navigateur sait faire des « view transitions », les œuvres qui restent
  // glissent jusqu'à leur nouvelle place, et les autres s'effacent au lieu de disparaître d'un coup.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const works = document.querySelectorAll<HTMLElement>('[data-type]');
  const years = document.querySelectorAll<HTMLElement>('[data-year]');
  const animateFilters = 'startViewTransition' in document && !reduceMotion;

  if (animateFilters) {
    // Chaque élément animé a besoin d'un nom unique pour que le navigateur le suive.
    works.forEach((li, i) => li.style.setProperty('view-transition-name', `work-${i}`));
    years.forEach((section, i) =>
      section.querySelector('h2')?.style.setProperty('view-transition-name', `year-${i}`),
    );
  }

  const applyFilter = (filter: string | undefined) => {
    works.forEach((li) => {
      li.hidden = filter !== 'all' && li.dataset.type !== filter;
    });
    years.forEach((section) => {
      section.hidden = !section.querySelector('[data-type]:not([hidden])');
    });
  };

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      if (button.getAttribute('aria-pressed') === 'true') return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      const filter = button.dataset.filter;
      if (animateFilters) document.startViewTransition(() => applyFilter(filter));
      else applyFilter(filter);
    }),
  );

  // Étoiles : elles s'allument une par une quand la note apparaît à l'écran (y compris
  // quand un filtre fait apparaître une œuvre). Sans script, elles restent simplement allumées.
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-lit');
          observer.unobserve(entry.target);
        }),
      { threshold: 1, rootMargin: '0px 0px -40px 0px' },
    );
    document.querySelectorAll<HTMLElement>('[data-stars]').forEach((rating) => {
      rating.setAttribute('data-animate', '');
      observer.observe(rating);
    });
  }

  // Quatrième mur : une nouvelle réplique dans la bulle à chaque survol, en partant d'une au hasard.
  document.querySelectorAll<HTMLElement>('[data-quips]').forEach((bubble) => {
    const lines: string[] = JSON.parse(bubble.dataset.quips ?? '[]');
    let next = Math.floor(Math.random() * lines.length);
    const show = () => {
      bubble.textContent = lines[next];
      next = (next + 1) % lines.length;
    };
    show();
    bubble.parentElement?.addEventListener('pointerenter', show);
  });

  // Couvertures en 3D : la couverture s'incline vers la souris, comme un livre qu'on sort du rayon.
  // Seulement avec une souris, et pas si le visiteur a demandé de réduire les animations.
  const canTilt = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (canTilt && !reduceMotion) {
    const maxTilt = 14; // degrés
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((cover) => {
      let frame = 0;
      cover.addEventListener('pointerenter', () => cover.classList.add('is-tilting'));
      cover.addEventListener('pointermove', (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = cover.getBoundingClientRect();
          // Position de la souris dans la couverture, de -0.5 à 0.5.
          const x = (event.clientX - box.left) / box.width - 0.5;
          const y = (event.clientY - box.top) / box.height - 0.5;
          cover.style.setProperty('--ry', `${x * maxTilt * 2}deg`);
          cover.style.setProperty('--rx', `${-y * maxTilt * 2}deg`);
          cover.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
          cover.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
          cover.style.setProperty('--sx', `${-x * 12}px`);
          cover.style.setProperty('--sy', `${8 - y * 8}px`);
        });
      });
      cover.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        cover.classList.remove('is-tilting');
        ['--rx', '--ry', '--gx', '--gy', '--sx', '--sy'].forEach((p) => cover.style.removeProperty(p));
      });
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }

  button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .works {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    gap: 0.8rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  /* Sans cette règle, `display: flex` l'emporte sur l'attribut `hidden` posé par les filtres. */
  li[hidden] {
    display: none;
  }

  .body {
    flex: 1;
    min-width: 0;
  }

  .cover-tilt {
    position: relative;
    flex-shrink: 0;
    width: 4.5rem;
    align-self: flex-start;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.15);
    transform: perspective(500px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s ease;
  }

  /* Pendant le survol : la couverture suit la souris sans retard, avance un peu et son ombre s'allonge. */
  .cover-tilt.is-tilting {
    transform: perspective(500px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(1.08);
    box-shadow: var(--sx, 0px) var(--sy, 8px) 18px rgb(0 0 0 / 0.28);
    transition:
      transform 0.1s linear,
      box-shadow 0.1s linear;
    z-index: 1;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Reflet de lumière qui suit la souris. */
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.4),
      rgb(255 255 255 / 0) 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .is-tilting .glare {
    opacity: 1;
  }

  /* Effet « papier découpé » (South Park) : au survol, la couverture saute d'une pose à l'autre
     sans transition, comme une animation en découpages, avec une ombre nette de carton. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='papercut']:hover {
      animation: papercut 0.8s steps(1, end) infinite;
      box-shadow: 3px 3px 0 rgb(0 0 0 / 0.35);
    }
  }

  @keyframes papercut {
    0% {
      transform: rotate(-3deg) translate(0, -2px);
    }
    25% {
      transform: rotate(2deg) translate(1px, 1px);
    }
    50% {
      transform: rotate(-1deg) translate(-1px, -3px);
    }
    75% {
      transform: rotate(3deg) translate(0, 0);
    }
  }

  /* Effet « élastique » (One Piece) : au survol, la couverture s'étire vers le texte comme du
     caoutchouc, puis revient à sa place en rebondissant de moins en moins fort. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='elastic']:hover {
      z-index: 1;
      transform-origin: right center;
      animation: elastic 0.9s ease-out both;
    }
  }

  @keyframes elastic {
    0% {
      transform: none;
    }
    22% {
      transform: scale(1.5, 0.82);
    }
    40% {
      transform: scale(0.82, 1.12);
    }
    56% {
      transform: scale(1.14, 0.93);
    }
    72% {
      transform: scale(0.95, 1.04);
    }
    86% {
      transform: scale(1.03, 0.99);
    }
    100% {
      transform: none;
    }
  }

  /* Effet « impacts de balle » (Sakamoto Days) : au survol, trois tirs à 0,18 s d'écart.
     À chaque tir, un trou apparaît avec un éclair et la couverture tressaute. Les trous
     restent tant que la souris est sur la couverture. */
  .hole {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 13px;
    height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    /* Trou noir au centre, bord de papier arraché plus clair, puis ombre qui s'estompe. */
    background: radial-gradient(
      circle,
      #0d0d0d 0 28%,
      #2b2b2b 36%,
      rgb(255 255 255 / 0.85) 44%,
      rgb(255 255 255 / 0.25) 56%,
      rgb(0 0 0 / 0.35) 64%,
      rgb(0 0 0 / 0) 72%
    );
  }

  /* Éclair orangé au moment de l'impact. */
  .hole::after {
    content: '';
    position: absolute;
    inset: -9px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 230 150 / 0.95), rgb(255 140 40 / 0) 65%);
    opacity: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='bullets']:hover {
      animation: recoil 0.18s ease-out 3;
    }

    [data-effect='bullets']:hover .hole {
      animation: hole-in 0.2s ease-out calc(var(--i) * 0.18s) both;
    }

    [data-effect='bullets']:hover .hole::after {
      animation: muzzle 0.22s ease-out calc(var(--i) * 0.18s) both;
    }
  }

  @keyframes recoil {
    0% {
      transform: none;
    }
    20% {
      transform: translate(2px, -1px) rotate(1.5deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes hole-in {
    from {
      opacity: 0;
      transform: scale(1.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes muzzle {
    0% {
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  /* Effet « tranchée » (Claymore) : au survol, un trait de lame traverse la couverture en
     diagonale, puis la moitié haute glisse et se décale. La coupe va de 70 % de la hauteur
     à gauche à 30 % à droite. Quand la souris s'en va, les deux morceaux se recollent. */
  [data-effect='slash'] {
    overflow: visible;
  }

  [data-effect='slash'] .cover {
    border-radius: 4px;
    transition:
      transform 0.3s ease-in,
      clip-path 0s 0.3s;
  }

  /* Au repos, la découpe couvre toute l'image. Elle a le même nombre de points que la
     découpe du survol : sans ça, le navigateur ne respecte pas le délai et l'image entière
     réapparaît avant que la moitié haute soit revenue, ce qui montre un doublon. */
  [data-effect='slash'] .cover:not(.slice-top) {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }

  .slice-top {
    position: absolute;
    inset: 0;
    clip-path: polygon(0 0, 100% 0, 100% 30%, 0 70%);
  }

  .slash {
    position: absolute;
    top: 50%;
    left: -12%;
    width: 124%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: #fff;
    box-shadow:
      0 0 4px 1px rgb(255 255 255 / 0.9),
      0 0 10px 2px rgb(190 215 255 / 0.7);
    transform: rotate(-32deg) scaleX(0);
    transform-origin: right center;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    /* L'ombre rectangulaire ne suivrait pas les morceaux : on la retire pendant la coupe. */
    [data-effect='slash']:hover {
      z-index: 1;
      box-shadow: none;
    }

    /* La couverture d'origine devient la moitié basse, qui recule un peu. */
    [data-effect='slash']:hover .cover:not(.slice-top) {
      clip-path: polygon(0 70%, 100% 30%, 100% 100%, 0 100%);
      transform: translate(2px, 3px);
      transition:
        transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) 0.14s,
        clip-path 0s 0.14s;
    }

    /* La moitié haute glisse le long de la coupe et penche. */
    [data-effect='slash']:hover .slice-top {
      transform: translate(-7px, -3px) rotate(-5deg);
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) 0.14s;
    }

    [data-effect='slash']:hover .slash {
      animation: slash 0.4s ease-out both;
    }
  }

  @keyframes slash {
    0% {
      opacity: 1;
      transform: rotate(-32deg) scaleX(0);
    }
    35% {
      opacity: 1;
      transform: rotate(-32deg) scaleX(1);
    }
    100% {
      opacity: 0;
      transform: rotate(-32deg) scaleX(1);
    }
  }

  /* Effet « éclipse » (Berserk) : au survol, la couverture s'assombrit et un cercle rouge se
     resserre sur ses bords, une éclipse se lève au milieu, puis la couverture se met à trembler. */
  .eclipse-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 40%, rgb(0 0 0 / 0) 20%, rgb(80 0 0 / 0.9) 100%),
      rgb(0 0 0 / 0.55);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .eclipse {
    position: absolute;
    left: 50%;
    top: 40%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    background: #050505;
    /* Couronne rouge autour du disque noir. */
    box-shadow:
      0 0 4px 2px rgb(255 70 50 / 0.95),
      0 0 16px 6px rgb(200 0 0 / 0.7),
      0 0 34px 12px rgb(140 0 0 / 0.45);
    opacity: 0;
    transform: translate(-50%, 10%) scale(0.6);
    transition:
      opacity 0.3s ease,
      transform 0.4s ease-in;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='eclipse']:hover {
      animation: tremble 0.14s linear 0.7s infinite;
    }

    [data-effect='eclipse']:hover .eclipse-veil {
      opacity: 1;
      transition-duration: 0.6s;
    }

    [data-effect='eclipse']:hover .eclipse {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
      transition:
        opacity 0.5s ease 0.1s,
        transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s;
    }
  }

  @keyframes tremble {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-1px, 0.5px);
    }
    50% {
      transform: translate(0.5px, -1px);
    }
    75% {
      transform: translate(1px, 0.5px);
    }
  }

  /* Effet « quatrième mur » (Deadpool) : au survol, la couverture pivote vers le visiteur
     et une bulle de BD apparaît au-dessus, avec une réplique différente à chaque fois. */
  [data-effect='fourth-wall'] {
    overflow: visible;
  }

  [data-effect='fourth-wall'] .cover {
    border-radius: 4px;
  }

  .bubble {
    position: absolute;
    right: 35%;
    bottom: calc(100% + 12px);
    width: max-content;
    max-width: 11rem;
    padding: 0.4rem 0.7rem;
    border: 2px solid var(--text);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.6);
    transform-origin: 80% 100%;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  /* Pointe de la bulle, tournée vers la couverture. */
  .bubble::after {
    content: '';
    position: absolute;
    right: 14px;
    bottom: -9px;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
    background: var(--bg);
    transform: skewX(25deg) rotate(45deg);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='fourth-wall']:hover {
      z-index: 2;
      transform: perspective(500px) rotateY(-18deg) scale(1.06);
    }

    [data-effect='fourth-wall']:hover .bubble {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s ease 0.15s,
        transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) 0.15s;
    }
  }

  /* Effet « pomme » (Death Note) : au survol, une pomme tombe sur la couverture, rebondit,
     puis se fait croquer deux fois. Les bouchées sont des cercles retirés de la pomme par un
     masque, dont le rayon s'agrandit (d'où les deux propriétés déclarées avec @property,
     sans quoi le navigateur ne saurait pas animer leur valeur). */
  @property --bite-1 {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --bite-2 {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .apple {
    position: absolute;
    /* Au-dessus du titre, côté droit, pour ne pas le cacher. */
    left: 70%;
    bottom: 22%;
    width: 38%;
    margin-left: -19%;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.4));
    mask-image:
      radial-gradient(circle at 100% 40%, transparent var(--bite-1), #000 calc(var(--bite-1) + 0.5px)),
      radial-gradient(circle at 97% 66%, transparent var(--bite-2), #000 calc(var(--bite-2) + 0.5px));
    mask-composite: intersect;
  }

  .apple svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='apple']:hover .apple {
      animation:
        apple-drop 0.9s both,
        bite-1 0.12s ease-out 1.05s both,
        bite-2 0.12s ease-out 1.45s both;
    }
  }

  @keyframes apple-drop {
    0% {
      opacity: 1;
      transform: translateY(-380%);
      animation-timing-function: ease-in;
    }
    45% {
      transform: none;
      animation-timing-function: ease-out;
    }
    62% {
      transform: translateY(-22%);
      animation-timing-function: ease-in;
    }
    78% {
      transform: none;
      animation-timing-function: ease-out;
    }
    88% {
      transform: translateY(-6%);
      animation-timing-function: ease-in;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes bite-1 {
    to {
      --bite-1: 6px;
    }
  }

  @keyframes bite-2 {
    to {
      --bite-2: 5px;
    }
  }

  /* Effet « portail » (Rick et Morty) : au survol, un portail vert s'ouvre derrière la
     couverture et tourne sur lui-même ; la couverture y est aspirée en tourbillonnant, puis
     ressort d'un coup. Ouverture et rotation passent par les propriétés `scale` et `rotate`,
     qui s'animent séparément sans s'écraser l'une l'autre. */
  [data-effect='portal'] {
    overflow: visible;
  }

  [data-effect='portal'] .cover {
    position: relative;
    z-index: 1;
    border-radius: 4px;
  }

  .portal {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 130%;
    aspect-ratio: 1;
    border-radius: 50%;
    pointer-events: none;
    translate: -50% -50%;
    scale: 0;
    /* Spirale verte (dégradé conique) sous un cœur lumineux qui s'estompe vers les bords. */
    background:
      radial-gradient(circle, #f4ffd0 0 10%, rgb(190 255 90 / 0.7) 26%, rgb(60 170 40 / 0) 52%),
      repeating-conic-gradient(from 0deg, #2f9e2a 0 22deg, #8fe01e 34deg, #2f9e2a 46deg);
    mask-image: radial-gradient(circle, #000 52%, transparent 70%);
    filter: drop-shadow(0 0 6px rgb(150 255 60 / 0.8));
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='portal']:hover {
      z-index: 1;
      box-shadow: none;
    }

    [data-effect='portal']:hover .portal {
      animation:
        portal-open 1.6s ease-out both,
        portal-spin 0.9s linear infinite;
    }

    [data-effect='portal']:hover .cover {
      animation: portal-suck 1.6s both;
    }
  }

  @keyframes portal-open {
    0% {
      scale: 0;
    }
    18% {
      scale: 1.05;
    }
    26%,
    78% {
      scale: 1;
    }
    100% {
      scale: 0;
    }
  }

  @keyframes portal-spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes portal-suck {
    0%,
    20% {
      transform: none;
      opacity: 1;
      animation-timing-function: ease-in;
    }
    50% {
      transform: scale(0) rotate(540deg);
      opacity: 0.4;
    }
    62% {
      transform: scale(0) rotate(540deg);
      opacity: 0;
      animation-timing-function: cubic-bezier(0.3, 1.6, 0.5, 1);
    }
    63% {
      opacity: 1;
    }
    82%,
    100% {
      transform: none;
      opacity: 1;
    }
  }

  /* Effet « claquement de doigts » (Marvel) : au survol, la couverture part en poussière de
     droite à gauche et des grains s'envolent, puis elle se reforme. Le masque efface l'image
     derrière un front qui avance (--dust), déclaré avec @property pour pouvoir l'animer. */
  @property --dust {
    syntax: '<percentage>';
    inherits: true;
    initial-value: -35%;
  }

  [data-effect='snap'] {
    overflow: visible;
  }

  [data-effect='snap'] .cover {
    border-radius: 4px;
    mask-image: linear-gradient(to left, transparent var(--dust), #000 calc(var(--dust) + 30%));
  }

  .dust {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 3px;
    height: 3px;
    border-radius: 1px;
    background: #8d8a86;
    pointer-events: none;
    opacity: 0;
  }

  .dust:nth-of-type(3n) {
    background: #4e4c4a;
  }

  .dust:nth-of-type(3n + 1) {
    background: #c4c0ba;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='snap']:hover {
      z-index: 1;
      box-shadow: none;
      animation: snap 3s ease-in-out both;
    }

    /* Chaque grain part quand le front de poussière atteint sa position. */
    [data-effect='snap']:hover .dust {
      animation: dust-fly 0.9s ease-out var(--delay) both;
    }
  }

  @keyframes snap {
    0%,
    8% {
      --dust: -35%;
    }
    50%,
    68% {
      --dust: 110%;
    }
    100% {
      --dust: -35%;
    }
  }

  @keyframes dust-fly {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(120deg) scale(0.4);
    }
  }

  /* Effet « cercle magique » (L'Atelier des Sorciers) : au survol, un cercle magique se
     dessine trait par trait à l'encre sur la couverture, comme tracé à la plume, puis
     s'illumine d'une lumière dorée tant que la souris reste dessus. */
  .glyph {
    position: absolute;
    left: 8%;
    top: 50%;
    width: 84%;
    translate: 0 -50%;
    overflow: visible;
    pointer-events: none;
    color: #0e2233;
    filter: drop-shadow(0 0 1.5px rgb(255 255 255 / 0.9));
  }

  .glyph * {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='glyph']:hover {
      z-index: 1;
    }

    [data-effect='glyph']:hover .glyph * {
      animation: ink 0.35s ease-in-out calc(var(--i) * 0.22s) both;
    }

    [data-effect='glyph']:hover .glyph {
      animation: glyph-glow 0.5s ease-out 1.6s both;
    }

    [data-effect='glyph']:hover .cover {
      animation: glyph-light 0.5s ease-out 1.6s both;
    }
  }

  @keyframes ink {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes glyph-glow {
    to {
      color: #fff5c8;
      filter: drop-shadow(0 0 2px #ffe27a) drop-shadow(0 0 6px rgb(255 200 60 / 0.8));
    }
  }

  @keyframes glyph-light {
    to {
      filter: brightness(1.15) saturate(1.2);
    }
  }

  /* Effet « Monde à l'envers » (Stranger Things) : au survol, la couverture clignote comme les
     guirlandes de Joyce, puis bascule tête en bas. Un voile froid la recouvre, des éclairs
     rouges le traversent et des spores montent lentement tant que la souris reste dessus. */
  .upside-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(rgb(10 20 45 / 0.55), rgb(60 10 20 / 0.5));
    opacity: 0;
  }

  .spore {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: rgb(235 235 255 / 0.85);
    box-shadow: 0 0 3px rgb(235 235 255 / 0.8);
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='upside-down']:hover {
      z-index: 1;
      animation: upside-flip 0.6s cubic-bezier(0.5, -0.4, 0.3, 1.4) 0.55s both;
    }

    [data-effect='upside-down']:hover .cover {
      animation: flicker 0.55s steps(1, end) both;
    }

    [data-effect='upside-down']:hover .upside-veil {
      animation:
        veil-in 0.4s ease-out 0.7s both,
        red-lightning 2.4s linear 1.2s infinite;
    }

    [data-effect='upside-down']:hover .spore {
      animation: spore-rise var(--s) linear 1s infinite;
    }
  }

  @keyframes upside-flip {
    to {
      transform: rotate(180deg);
    }
  }

  @keyframes flicker {
    0%,
    30%,
    60% {
      filter: brightness(0.35);
    }
    15%,
    45%,
    80% {
      filter: brightness(1.25);
    }
    100% {
      filter: none;
    }
  }

  @keyframes veil-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* L'éclair est un bref flash rouge en deux temps, puis plus rien jusqu'au suivant. */
  @keyframes red-lightning {
    0%,
    8%,
    16%,
    100% {
      opacity: 1;
      box-shadow: none;
    }
    4%,
    12% {
      opacity: 1;
      box-shadow: inset 0 0 22px 6px rgb(255 40 40 / 0.85);
    }
  }

  @keyframes spore-rise {
    0% {
      opacity: 0;
      transform: none;
    }
    20%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(6px, -60px);
    }
  }

  /* Effet « écran brisé » (Black Mirror) : au survol, la couverture encaisse un choc et se fige
     une fraction de seconde sur un décalage de couleurs, puis les fissures partent du point
     d'impact. Comme pour le cercle magique, chaque trait est tracé avec pathLength="1". */
  .cracks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 0 0.6px rgb(0 0 0 / 0.9));
  }

  .cracks * {
    fill: none;
    stroke: rgb(255 255 255 / 0.92);
    stroke-width: 0.9;
    stroke-linejoin: bevel;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='crack']:hover {
      animation: impact 0.25s ease-out both;
    }

    [data-effect='crack']:hover .cover {
      animation: glitch 0.3s steps(1, end) both;
    }

    [data-effect='crack']:hover .cracks * {
      animation: crack-run 0.22s ease-out 0.05s both;
    }

    /* Les anneaux autour de l'impact se dessinent juste après les rayons. */
    [data-effect='crack']:hover .cracks circle {
      animation-delay: 0.18s;
    }
  }

  @keyframes impact {
    0% {
      transform: none;
    }
    25% {
      transform: translate(2px, 1px) scale(0.97);
    }
    60% {
      transform: translate(-1px, 0);
    }
    100% {
      transform: none;
    }
  }

  @keyframes glitch {
    0% {
      filter: drop-shadow(3px 0 0 rgb(255 0 60 / 0.8)) drop-shadow(-3px 0 0 rgb(0 220 255 / 0.8));
    }
    40% {
      filter: drop-shadow(-2px 0 0 rgb(255 0 60 / 0.8)) drop-shadow(2px 0 0 rgb(0 220 255 / 0.8))
        grayscale(1);
    }
    80% {
      filter: none;
    }
  }

  @keyframes crack-run {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Effet « comète » (Your Name.) : au survol, le ciel vire au crépuscule et une comète
     traverse la couverture en diagonale. À mi-chemin, un fragment s'en détache et file un peu
     plus bas, comme la comète Tiamat. */
  .twilight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(170deg, rgb(70 60 170 / 0.55), rgb(230 90 150 / 0.35) 55%, rgb(255 170 90 / 0.3));
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* La comète : une tête lumineuse et une traîne en dégradé, inclinée dans le sens du trajet. */
  .comet {
    position: absolute;
    left: 100%;
    top: -10%;
    width: 60%;
    height: 4px;
    border-radius: 2px;
    pointer-events: none;
    background: linear-gradient(to right, #fff, rgb(120 200 255 / 0.85) 25%, rgb(140 120 255 / 0));
    /* Halo bleuté marqué : l'affiche de Your Name. est surtout un ciel clair. */
    box-shadow:
      0 0 4px 1px rgb(255 255 255 / 0.9),
      0 0 12px 3px rgb(90 170 255 / 0.75);
    transform-origin: left center;
    rotate: -55deg;
    opacity: 0;
  }

  .comet-shard {
    width: 35%;
    height: 3px;
    background: linear-gradient(to right, rgb(255 230 255 / 0.95), rgb(255 140 210 / 0.6) 25%, rgb(255 120 200 / 0));
    box-shadow: 0 0 6px 1px rgb(255 170 230 / 0.8);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='comet']:hover .twilight {
      opacity: 1;
    }

    [data-effect='comet']:hover .comet {
      animation: comet-fall 1.1s ease-in 0.15s both;
    }

    [data-effect='comet']:hover .comet-shard {
      animation: shard-fall 0.75s ease-in 0.6s both;
    }
  }

  @keyframes comet-fall {
    0% {
      opacity: 1;
      translate: 0 0;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      /* En rem et non en % : un pourcentage de `translate` se rapporte à la comète elle-même
         (3 px de haut), pas à la couverture. Le trajet va du coin haut droit au coin bas
         gauche et suit l'inclinaison de 55°. */
      translate: -5.5rem 7.8rem;
    }
  }

  /* Le fragment part à peu près de l'endroit où se trouve la comète à ce moment-là, puis
     s'écarte avec une pente plus raide. Il reste invisible pendant son délai de départ. */
  @keyframes shard-fall {
    0% {
      opacity: 0;
      translate: -1.2rem 1.7rem;
      rotate: -55deg;
    }
    8%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: -3.2rem 7.6rem;
      rotate: -68deg;
    }
  }

  /* Effet « projecteur » (The Truman Show) : au survol, un projecteur de studio tombe du ciel
     au pied de la couverture, comme dans le film. La couverture tressaute sous le choc, un
     faisceau de lumière l'éclaire d'en haut et le voyant « EN DIRECT » se met à clignoter. */
  [data-effect='spotlight'] {
    overflow: visible;
  }

  [data-effect='spotlight'] .cover {
    border-radius: 4px;
  }

  .stage-light {
    position: absolute;
    left: -10%;
    bottom: -8%;
    width: 42%;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.4));
  }

  .stage-light svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .beam {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 75% at 50% 0%, rgb(255 250 220 / 0.55), rgb(255 250 220 / 0) 70%);
    opacity: 0;
  }

  .on-air {
    position: absolute;
    top: 5%;
    right: 5%;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgb(0 0 0 / 0.75);
    color: #ff3b3b;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='spotlight']:hover {
      z-index: 1;
      animation: thud 0.3s ease-out 0.55s both;
    }

    [data-effect='spotlight']:hover .stage-light {
      animation: light-drop 0.6s both;
    }

    [data-effect='spotlight']:hover .beam {
      animation: veil-in 0.4s ease-out 0.75s both;
    }

    [data-effect='spotlight']:hover .on-air {
      animation: on-air 1s steps(1, end) 0.9s infinite;
    }
  }

  @keyframes light-drop {
    0% {
      opacity: 1;
      transform: translateY(-600%) rotate(-25deg);
      animation-timing-function: ease-in;
    }
    90% {
      opacity: 1;
      transform: rotate(8deg);
      animation-timing-function: ease-out;
    }
    100% {
      opacity: 1;
      transform: rotate(-12deg);
    }
  }

  @keyframes thud {
    0% {
      transform: none;
    }
    30% {
      transform: translateY(2px) rotate(-1deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes on-air {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  /* Effet « extension du territoire » (Jujutsu Kaisen) : au survol, les ténèbres se referment
     sur la couverture depuis les bords et ses couleurs s'éteignent. Puis, tant que la souris
     reste dessus, un éclair noir bordé de rouge la frappe régulièrement et la fait sursauter. */
  .domain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 0 rgb(20 0 35 / 0);
  }

  .black-flash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 0 1.5px #ff2a2a) drop-shadow(0 0 4px rgb(255 0 0 / 0.75));
  }

  .black-flash path {
    fill: none;
    stroke: #0a0a0a;
    stroke-width: 2.5;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='domain']:hover {
      animation: domain-jolt 2.2s linear 0.9s infinite;
    }

    [data-effect='domain']:hover .domain {
      animation: domain-close 0.8s ease-in both;
    }

    [data-effect='domain']:hover .cover {
      animation: domain-dim 0.8s ease-in both;
    }

    [data-effect='domain']:hover .black-flash {
      animation: black-flash 2.2s linear 0.9s infinite;
    }
  }

  @keyframes domain-close {
    to {
      box-shadow: inset 0 0 16px 22px rgb(20 0 35 / 0.92);
    }
  }

  @keyframes domain-dim {
    to {
      filter: saturate(0.45) brightness(0.8) hue-rotate(-20deg);
    }
  }

  /* Deux flashs rapprochés, puis plus rien jusqu'au cycle suivant. */
  @keyframes black-flash {
    0% {
      opacity: 1;
    }
    6% {
      opacity: 0;
    }
    9% {
      opacity: 1;
    }
    15%,
    100% {
      opacity: 0;
    }
  }

  @keyframes domain-jolt {
    0% {
      transform: translate(-2px, 1px) scale(1.04);
    }
    8% {
      transform: translate(2px, -1px) scale(1.02);
    }
    16%,
    100% {
      transform: none;
    }
  }

  /* Effet « toile » (Spider-Man) : au survol, une toile se tisse depuis le coin haut droit,
     d'abord les rayons puis les fils, et la couverture se fait tirer d'un coup vers le haut. */
  .web {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.9));
  }

  .web path {
    fill: none;
    stroke: #fff;
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='web']:hover {
      animation: web-tug 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 1.2s both;
    }

    [data-effect='web']:hover .web path {
      animation: ink 0.3s ease-out calc(var(--i) * 0.06s) both;
    }
  }

  @keyframes web-tug {
    0% {
      transform: none;
    }
    35% {
      transform: translate(2px, -6px) rotate(2deg);
    }
    100% {
      transform: translate(1px, -3px) rotate(1deg);
    }
  }

  /* Effet « écran partagé » (OSS 117 : Rio ne répond plus) : au survol, la couverture se
     découpe en trois bandes qui arrivent l'une après l'autre, par le haut ou par le bas,
     chacune avec sa teinte, et s'arrêtent en décalé sur un fond orange, comme un générique
     des années 60. */
  [data-effect='split-screen'] {
    background: #e8742c;
  }

  .strip {
    position: absolute;
    inset: 0;
    height: 100%;
    object-fit: cover;
    clip-path: var(--clip);
    filter: var(--tint);
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='split-screen']:hover .cover:not(.strip) {
      opacity: 0;
    }

    [data-effect='split-screen']:hover .strip {
      animation: strip-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 0.14s) both;
    }
  }

  @keyframes strip-in {
    from {
      opacity: 1;
      transform: translateY(calc(var(--dir) * 100%));
    }
    /* Les bandes s'arrêtent un peu décalées, pour qu'on voie bien trois plans distincts. */
    to {
      opacity: 1;
      transform: translateY(calc(var(--dir) * -7%));
    }
  }

  /* Effet « triangle » (Souvenirs de Gravity Falls) : au survol, la couverture vire au jaune,
     un triangle à l'œil unique surgit en tournoyant, puis flotte et cligne de l'œil tant que
     la souris reste dessus. */
  .cipher-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgb(250 200 40 / 0.5);
    mix-blend-mode: multiply;
    opacity: 0;
  }

  .cipher {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 62%;
    translate: -50% -50%;
    scale: 0;
    pointer-events: none;
    filter: drop-shadow(0 0 4px rgb(255 230 80 / 0.9));
  }

  .cipher svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cipher-eye {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='cipher']:hover .cipher-tint {
      animation: veil-in 0.4s ease-out both;
    }

    [data-effect='cipher']:hover .cipher {
      animation:
        cipher-rise 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) 0.3s both,
        cipher-float 2s ease-in-out 0.9s infinite;
    }

    [data-effect='cipher']:hover .cipher-eye {
      animation: cipher-blink 3s ease-in-out 0.9s infinite;
    }
  }

  @keyframes cipher-rise {
    from {
      scale: 0;
      rotate: -200deg;
    }
    to {
      scale: 1;
      rotate: 0deg;
    }
  }

  @keyframes cipher-float {
    0%,
    100% {
      transform: none;
    }
    50% {
      transform: translateY(-3px);
    }
  }

  /* L'œil s'ouvre au début de chaque cycle, reste ouvert, puis cligne. */
  @keyframes cipher-blink {
    0% {
      transform: scaleY(0);
    }
    8%,
    88%,
    96%,
    100% {
      transform: scaleY(1);
    }
    92% {
      transform: scaleY(0.1);
    }
  }

  /* Effet « skadoosh » (Kung Fu Panda) : au survol, la couverture se crispe et tremble comme
     prise dans la prise du petit doigt, puis s'illumine d'or pendant que deux ondes de choc
     dorées partent en anneau. */
  [data-effect='skadoosh'] {
    overflow: visible;
  }

  [data-effect='skadoosh'] .cover {
    border-radius: 4px;
  }

  .shockwave {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 3px solid #ffd35a;
    box-shadow:
      0 0 8px #ffcc33,
      inset 0 0 8px #ffcc33;
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='skadoosh']:hover {
      z-index: 1;
      animation: skadoosh-hold 0.5s linear both;
    }

    [data-effect='skadoosh']:hover .cover {
      animation: gold-flash 0.7s ease-out 0.5s both;
    }

    [data-effect='skadoosh']:hover .shockwave {
      animation: shockwave 0.8s ease-out calc(0.5s + var(--i) * 0.15s) both;
    }
  }

  @keyframes skadoosh-hold {
    0% {
      transform: none;
    }
    20%,
    60% {
      transform: scale(0.95) translateX(-1px);
    }
    40%,
    80% {
      transform: scale(0.95) translateX(1px);
    }
    100% {
      transform: none;
    }
  }

  @keyframes gold-flash {
    0% {
      filter: none;
    }
    20% {
      filter: brightness(1.8) sepia(0.7) saturate(2.2);
    }
    100% {
      filter: none;
    }
  }

  @keyframes shockwave {
    from {
      opacity: 1;
      scale: 0.2;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }

  /* Effet « souffle de l'eau » (Demon Slayer) : au survol, une vague bleue traverse la
     couverture en tourbillonnant, avec sa crête claire et son filet d'écume, comme une
     estampe. La couverture accuse le coup et prend un reflet bleuté. */
  .water {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 1px 1px rgb(0 20 60 / 0.5));
  }

  .water path {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .water .wave {
    stroke: #1f6fd1;
    stroke-width: 9;
  }

  .water .crest {
    stroke: #7cc4ff;
    stroke-width: 3;
  }

  .water .foam {
    stroke: #eaf6ff;
    stroke-width: 2;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='water']:hover {
      animation: water-hit 0.6s ease-out 0.3s both;
    }

    [data-effect='water']:hover .water path {
      animation: ink 0.7s ease-in-out calc(var(--i) * 0.1s) both;
    }

    [data-effect='water']:hover .cover {
      animation: water-tint 0.6s ease-out 0.3s both;
    }
  }

  @keyframes water-hit {
    0% {
      transform: none;
    }
    30% {
      transform: translateX(3px) rotate(1.5deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes water-tint {
    to {
      filter: saturate(1.1) hue-rotate(-10deg) brightness(1.05);
    }
  }

  /* Effet « parachute » (La Grande Vadrouille) : au survol, un parachutiste descend en se
     balançant et atterrit sur le haut de la couverture, qui plie un peu sous le choc. La voile
     s'affaisse ensuite derrière lui. */
  [data-effect='parachute'] {
    overflow: visible;
  }

  [data-effect='parachute'] .cover {
    border-radius: 4px;
  }

  .parachute {
    position: absolute;
    left: calc(50% - 1.3rem);
    top: -3.25rem;
    width: 2.6rem;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
  }

  .parachute svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .canopy {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='parachute']:hover {
      z-index: 1;
      animation: thud 0.3s ease-out 1.45s both;
    }

    [data-effect='parachute']:hover .parachute {
      animation: parachute-drop 1.5s ease-out both;
    }

    [data-effect='parachute']:hover .canopy {
      animation: canopy-fold 0.5s ease-in 1.55s both;
    }
  }

  @keyframes parachute-drop {
    0% {
      opacity: 1;
      transform: translateY(-300%) rotate(-14deg);
    }
    25% {
      transform: translateY(-210%) rotate(12deg);
    }
    50% {
      transform: translateY(-125%) rotate(-9deg);
    }
    75% {
      transform: translateY(-50%) rotate(6deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes canopy-fold {
    to {
      transform: translate(30%, 30%) rotate(35deg) scaleY(0.55);
      opacity: 0.85;
    }
  }

  /* Effet « signal » (The Batman) : au survol, la nuit tombe sur la couverture et la pluie se
     met à tomber. Un faisceau monte du coin bas gauche et le signal de chauve-souris s'allume
     dans le ciel en grésillant, puis reste allumé tant que la souris est dessus. */
  .night,
  .rain,
  .signal-beam {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }

  .night {
    background: linear-gradient(rgb(8 12 28 / 0.8), rgb(15 20 35 / 0.6));
  }

  .rain {
    background: repeating-linear-gradient(
      100deg,
      rgb(200 215 235 / 0) 0 5px,
      rgb(200 215 235 / 0.4) 5px 6px
    );
    mask-image: repeating-linear-gradient(rgb(0 0 0) 0 9px, rgb(0 0 0 / 0) 9px 16px);
  }

  .signal-beam {
    background: linear-gradient(to top right, rgb(255 245 190 / 0.4), rgb(255 245 190 / 0.12));
    clip-path: polygon(6% 100%, 22% 100%, 82% 30%, 20% 14%);
  }

  .signal {
    position: absolute;
    left: 50%;
    top: 7%;
    width: 80%;
    aspect-ratio: 1.7;
    translate: -50% 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(255 245 190 / 0.95) 0 70%,
      rgb(255 240 170 / 0.5) 85%,
      rgb(255 240 170 / 0)
    );
    opacity: 0;
  }

  .signal svg {
    width: 72%;
    height: auto;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='bat-signal']:hover .night {
      animation: veil-in 0.4s ease-out both;
    }

    [data-effect='bat-signal']:hover .rain {
      animation:
        veil-in 0.4s ease-out both,
        rain 0.35s linear infinite;
    }

    [data-effect='bat-signal']:hover .signal-beam,
    [data-effect='bat-signal']:hover .signal {
      animation: signal-on 0.6s steps(1, end) 0.5s both;
    }
  }

  @keyframes rain {
    from {
      mask-position: 0 0;
      background-position: 0 0;
    }
    to {
      mask-position: 0 16px;
      background-position: -3px 0;
    }
  }

  @keyframes signal-on {
    0% {
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    35% {
      opacity: 0.2;
    }
    55% {
      opacity: 1;
    }
    70% {
      opacity: 0.4;
    }
    85%,
    100% {
      opacity: 1;
    }
  }

  /* Effet « soucoupe » (DAN DA DAN) : au survol, une soucoupe volante arrive par la droite et
     se met en vol stationnaire au-dessus de la couverture. Son rayon tracteur s'allume et
     aspire la couverture, qui monte en tournoyant, puis la relâche : elle retombe à sa place. */
  [data-effect='ufo'] {
    overflow: visible;
  }

  [data-effect='ufo'] .cover {
    border-radius: 4px;
  }

  .saucer {
    position: absolute;
    left: calc(50% - 1.8rem);
    top: -1.3rem;
    width: 3.6rem;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.35));
  }

  .saucer svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ufo-light {
    fill: #ffe066;
  }

  .tractor {
    position: absolute;
    left: -15%;
    right: -15%;
    top: -0.3rem;
    bottom: 0;
    pointer-events: none;
    clip-path: polygon(38% 0, 62% 0, 100% 100%, 0 100%);
    background: linear-gradient(rgb(170 255 170 / 0.75), rgb(170 255 170 / 0.15));
    opacity: 0;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-effect='ufo']:hover {
      z-index: 1;
    }

    [data-effect='ufo']:hover .saucer {
      animation:
        ufo-arrive 0.6s ease-out both,
        ufo-hover 1.2s ease-in-out 0.6s infinite;
    }

    [data-effect='ufo']:hover .ufo-light {
      animation: ufo-blink 0.6s steps(1, end) calc(var(--i) * 0.12s) infinite;
    }

    [data-effect='ufo']:hover .tractor {
      animation: tractor 2.4s ease-out 0.55s both;
    }

    [data-effect='ufo']:hover .cover {
      animation: ufo-lift 2.4s ease-in-out 0.6s both;
    }
  }

  @keyframes ufo-arrive {
    from {
      opacity: 1;
      transform: translateX(260%) rotate(12deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ufo-hover {
    0%,
    100% {
      opacity: 1;
      transform: none;
    }
    50% {
      opacity: 1;
      transform: translateY(-2px) rotate(-2deg);
    }
  }

  @keyframes ufo-blink {
    0% {
      fill: #ffe066;
    }
    50% {
      fill: #7cff9b;
    }
  }

  @keyframes tractor {
    0% {
      opacity: 0;
    }
    6%,
    78% {
      opacity: 1;
    }
    85%,
    100% {
      opacity: 0;
    }
  }

  @keyframes ufo-lift {
    0% {
      transform: none;
    }
    35% {
      transform: translateY(-22%) scale(0.72) rotate(-6deg);
    }
    50% {
      transform: translateY(-25%) scale(0.7) rotate(5deg);
    }
    65% {
      transform: translateY(-22%) scale(0.72) rotate(-4deg);
    }
    78% {
      transform: translateY(-24%) scale(0.71) rotate(3deg);
      animation-timing-function: ease-in;
    }
    92% {
      transform: translateY(2%) scale(1);
    }
    100% {
      transform: none;
    }
  }

  .icon {
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .progress {
    display: block;
  }

  .stars {
    display: block;
    color: var(--accent);
    font-size: 0.9rem;
  }

  /* Chaque étoile est une étoile vide (☆), recouverte d'une étoile pleine (★) entière ou à moitié. */
  .star {
    position: relative;
    display: inline-block;
    margin-right: 0.1em;
  }

  .star.full::before,
  .star.half::before {
    content: '★';
    position: absolute;
    inset: 0;
  }

  .star.half::before {
    clip-path: inset(0 50% 0 0);
  }

  /* Animation : le script pose data-animate (étoiles éteintes), puis is-lit quand la note
     apparaît à l'écran. Les étoiles s'allument alors une par une, avec un petit rebond. */
  .stars[data-animate] .star::before {
    opacity: 0;
    transform: scale(0);
  }

  .stars[data-animate].is-lit .star::before {
    animation: star-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) calc(var(--i) * 0.12s) both;
  }

  @keyframes star-pop {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-40deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.35) rotate(8deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  li p {
    margin: 0.25rem 0;
  }
</style>

<!-- Animations des filtres : les pseudo-éléments ::view-transition vivent à la racine du document,
     hors de portée des styles de la page, d'où le bloc global. -->
<style is:global>
  /* Les œuvres qui restent glissent jusqu'à leur nouvelle place. */
  ::view-transition-group(*) {
    animation-duration: 0.45s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Une œuvre qui apparaît monte légèrement en fondu. */
  ::view-transition-new(*):only-child {
    animation: shelf-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }

  /* Une œuvre qui s'en va rétrécit un peu en s'effaçant. */
  ::view-transition-old(*):only-child {
    animation: shelf-out 0.2s ease-in both;
  }

  @keyframes shelf-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
  }

  @keyframes shelf-out {
    to {
      opacity: 0;
      transform: scale(0.97);
    }
  }
</style>
