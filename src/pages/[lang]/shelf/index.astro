---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDate, langs, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const items = (await getCollection('shelf')).sort(
  (a, b) => b.data.finished.valueOf() - a.data.finished.valueOf(),
);

// Regroupe les œuvres par année de fin.
const byYear = new Map<number, typeof items>();
for (const item of items) {
  const year = item.data.finished.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), item]);
}

const icons = { book: '📖', film: '🎬', album: '💿' } as const;
const filters = ['all', 'book', 'film', 'album'] as const;
const stars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));
---

<Base lang={lang} title={t(lang, 'shelf.title')} description={t(lang, 'shelf.intro')}>
  <h1>{t(lang, 'shelf.title')}</h1>
  <p class="lead">{t(lang, 'shelf.intro')}</p>

  {
    items.length === 0 ? (
      <p class="muted">{t(lang, 'shelf.empty')}</p>
    ) : (
      <>
        <div class="filters" role="group">
          {filters.map((f) => (
            <button type="button" data-filter={f} aria-pressed={f === 'all' ? 'true' : 'false'}>
              {t(lang, f === 'all' ? 'shelf.all' : `shelf.${f}`)}
            </button>
          ))}
        </div>

        {[...byYear].map(([year, works]) => (
          <section data-year>
            <h2>{year}</h2>
            <ul class="works">
              {works.map(({ data }) => (
                <li data-type={data.type}>
                  <span class="icon" aria-hidden="true">
                    {icons[data.type]}
                  </span>
                  <div>
                    <strong>{data.title}</strong>
                    <span class="muted">
                      {' '}
                      — {data.creator}
                      {data.year && ` (${data.year})`}
                    </span>
                    {data.rating !== undefined && (
                      <span class="stars" aria-label={`${data.rating}/5`}>
                        {stars(data.rating)}
                      </span>
                    )}
                    {data.review && <p>{data.review}</p>}
                    <time class="muted small" datetime={data.finished.toISOString()}>
                      {formatDate(data.finished, lang)}
                    </time>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )
  }
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document.querySelectorAll<HTMLElement>('[data-type]').forEach((li) => {
        li.hidden = filter !== 'all' && li.dataset.type !== filter;
      });
      document.querySelectorAll<HTMLElement>('[data-year]').forEach((section) => {
        section.hidden = !section.querySelector('[data-type]:not([hidden])');
      });
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }

  button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .works {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    gap: 0.8rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .icon {
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .stars {
    display: block;
    color: var(--accent);
    letter-spacing: 0.1em;
    font-size: 0.9rem;
  }

  li p {
    margin: 0.25rem 0;
  }
</style>
