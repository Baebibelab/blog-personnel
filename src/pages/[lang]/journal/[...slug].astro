---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostHeader from '../../../components/PostHeader.astro';
import { href, t, type Lang } from '../../../i18n/ui';
import { entryLang, entrySlug, getProjects } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('journal', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({
    params: { lang: entryLang(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const { Content } = await render(entry);

const project = entry.data.project
  ? (await getProjects(lang)).find((p) => p.data.key === entry.data.project)
  : undefined;
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
  <article>
    <PostHeader
      lang={lang}
      title={entry.data.title}
      date={entry.data.date}
      tags={entry.data.tags}
      project={project && { title: project.data.title, href: href(lang, 'projects', entrySlug(project.id)) }}
    />
    <div class="prose"><Content /></div>
  </article>
  <hr />
  <p><a href={href(lang, 'journal')}>← {t(lang, 'post.backTo')} {t(lang, 'journal.title')}</a></p>
</Base>
