---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import ListenRow from '../../components/ListenRow.astro';
import { href, langs, t, type Lang } from '../../i18n/ui';
import { entrySlug, getJournal, getNotes, getProjects } from '../../lib/content';
import { getRecentListens } from '../../lib/jellyfin';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const journal = (await getJournal(lang)).slice(0, 5);
const notes = (await getNotes(lang)).slice(0, 5);
const projects = await getProjects(lang);
const listening = await getRecentListens();
const last = listening?.items[0];
---

<Base lang={lang}>
  <p class="lead">{t(lang, 'home.intro')}</p>

  <section>
    <div class="section-head">
      <h2>{t(lang, 'home.latestJournal')}</h2>
      <a class="small" href={href(lang, 'journal')}>{t(lang, 'seeAll')}</a>
    </div>
    <PostList
      lang={lang}
      items={journal.map((e) => ({
        title: e.data.title,
        href: href(lang, 'journal', entrySlug(e.id)),
        date: e.data.date,
        description: e.data.description,
        draft: e.data.draft,
      }))}
    />
  </section>

  <section>
    <div class="section-head">
      <h2>{t(lang, 'home.projects')}</h2>
      <a class="small" href={href(lang, 'projects')}>{t(lang, 'seeAll')}</a>
    </div>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="card" href={href(lang, 'projects', entrySlug(p.id))}>
            <h3>{p.data.title}</h3>
            <p class="muted small">{p.data.tagline}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>{t(lang, 'home.latestNotes')}</h2>
      <a class="small" href={href(lang, 'notes')}>{t(lang, 'seeAll')}</a>
    </div>
    <PostList
      lang={lang}
      items={notes.map((e) => ({
        title: e.data.title,
        href: href(lang, 'notes', entrySlug(e.id)),
        date: e.data.updated ?? e.data.date,
        draft: e.data.draft,
      }))}
    />
  </section>

  {
    last && (
      <section>
        <div class="section-head">
          <h2>{t(lang, 'home.nowPlaying')}</h2>
          <a class="small" href={href(lang, 'listening')}>{t(lang, 'seeAll')}</a>
        </div>
        <ListenRow lang={lang} listen={last} />
      </section>
    )
  }
</Base>
