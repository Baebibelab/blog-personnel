---
// La racine du site renvoie vers la version française.
import { href } from '../i18n/ui';

const fr = href('fr');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fr} />
    <meta http-equiv="refresh" content={`0; url=${fr}`} />
  </head>
  <body>
    <p><a href={fr}>Entrer sur le site</a></p>
  </body>
</html>
