---
// La racine du site renvoie vers la version française,
// ou anglaise si le navigateur est réglé en anglais.
import { href } from '../i18n/ui';

const fr = href('fr');
const en = href('en');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fr} />
    <script is:inline define:vars={{ fr, en }}>
      const english = (navigator.languages || [navigator.language]).some((l) => /^en\b/i.test(l))
        && !(navigator.languages || []).some((l) => /^fr\b/i.test(l));
      location.replace(english ? en : fr);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fr}`} /></noscript>
  </head>
  <body>
    <p><a href={fr}>Français</a> · <a href={en}>English</a></p>
  </body>
</html>
